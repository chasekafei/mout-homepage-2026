{
  "name": "mout-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:im": "pnpm --filter @mout/im build",
    "build:agent": "pnpm --filter @mout/agent-core typecheck && pnpm --filter @mout/agent-api typecheck",
    "build:all": "pnpm build && pnpm build:im && pnpm build:agent",
    "test:retrieval": "pnpm --filter @mout/agent-core test",
    "preview": "vite preview",
    "content": "node tools/content/build-content.mjs",
    "assets": "node tools/content/build-assets.mjs"
  },
  "dependencies": {
    "@mout/chat-ui": "workspace:*",
    "meshoptimizer": "1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gltfpack": "^1.3.0",
    "marked": "^15.0.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.34.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.1"
  }
}
